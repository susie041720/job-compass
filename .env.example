# AI 是可选能力；未配置时手动录入、批量表格导入和投递管理仍可使用。
# 只把真实值写入本机 .env，不要提交到 GitHub。
AI_PROVIDER=openai-compatible
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
AI_API_BASE_URL=https://api.openai.com/v1

# 公开演示站部署时设为 true；本地个人版请保持 false。
# 开启后，投递记录只在访客浏览器本地操作；所有服务端写入、上传、外部抓取和 AI 调用都会被拒绝。
PUBLIC_DEMO_MODE=false

# Cloudflare 部署构建时填写。它们不是密码，但每个账号的值不同。
CLOUDFLARE_D1_DATABASE_NAME=job-compass-public
CLOUDFLARE_D1_DATABASE_ID=
